{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },

  // SMTP sink — two delivery modes, selected by whether SmtpHost is set.
  //
  // MODE 1 – Pickup-directory (development / local testing)
  //   Leave SmtpHost empty.  The sink writes .eml files to PickupDirectory
  //   for a local SMTP relay to deliver.  No credentials required.
  //
  // MODE 2 – Network SMTP (staging / production)
  //   Set SmtpHost (and optionally SmtpPort / EnableSsl).
  //   The sink connects directly to the mail server.
  //   Supply Username and Password via environment variables or user-secrets
  //   — NEVER commit real credentials to source control:
  //     $env:SmtpPickupDir__Username = "noreply@yourcompany.com"
  //     $env:SmtpPickupDir__Password = "<app-password>"
    "SmtpPickupDir": {
        "From": "",
        "To": "",
        "Subject": "BrainstormSessions Log Alert",

        // --- Pickup-directory mode (active when SmtpHost is blank) ---
        "PickupDirectory": "smtp-pickup",

        // --- Network mode (active when SmtpHost is set) ---
        "SmtpHost": "",
        "SmtpPort": 587,
        "EnableSsl": true,
        "Username": "",
        "Password": ""
    }
}
